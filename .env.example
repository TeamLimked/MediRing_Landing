# 공개 값만 넣는다(번들/HTML 에 그대로 포함됨)
NUXT_PUBLIC_SITE_URL=https://mediring.io
# 스토어 링크(비우면 "출시 예정" 상태로 표시)
NUXT_PUBLIC_APP_STORE_URL=
NUXT_PUBLIC_PLAY_STORE_URL=
# 약관·정책 페이지의 회사 정보(비우면 자리표시자). 백엔드 COMPANY_* / PRIVACY_OFFICER_* / POLICY_VERSION 과 같은 값
NUXT_PUBLIC_COMPANY_NAME=TeamLimked
NUXT_PUBLIC_COMPANY_REPRESENTATIVE=
NUXT_PUBLIC_COMPANY_BUSINESS_NUMBER=
NUXT_PUBLIC_COMPANY_ADDRESS=
NUXT_PUBLIC_COMPANY_PRIVACY_OFFICER=
NUXT_PUBLIC_COMPANY_PRIVACY_EMAIL=privacy@mediring.io
NUXT_PUBLIC_COMPANY_SUPPORT_EMAIL=support@mediring.io
NUXT_PUBLIC_COMPANY_POLICY_VERSION=2026-09-28
# 법무 확정 후 false (백엔드 LEGAL_DRAFT_BANNER 와 함께)
NUXT_PUBLIC_COMPANY_LEGAL_DRAFT=true
# 메시지 테스트(/try/a·/try/b) 사전 신청을 받는 Google Apps Script 웹 앱 URL(scripts/waitlist-apps-script.gs). 비우면 신청을 받지 않는다
NUXT_PUBLIC_WAITLIST_ENDPOINT=
# 신청 내용 보관처: google(국외 이전 동의를 함께 받음) | domestic
NUXT_PUBLIC_WAITLIST_STORAGE=google
